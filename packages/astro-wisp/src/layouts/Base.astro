---
/**
 * 全站基础布局：主题初始化脚本（先于样式执行）、字体、meta/OG/canonical/RSS、lang、
 * SkipLink、Header、<main id="main">、Footer。
 * main 不限制宽度，页面自行使用 `.wisp-container` 或自己的网格。
 */
// 第一个引入：声明 cascade layer 顺序
import '../styles/layers.css';
// 思源黑体只在 CJK 页面加载；Inter / JetBrains Mono 由 Astro Fonts API 提供（见 src/fonts.ts）
import notoCssUrl from '@fontsource-variable/noto-sans-sc/index.css?url';
import 'virtual:wisp/theme-css';
import '../styles/global.css';
// 站点的 customCss：不分层、最后引入，可以覆盖主题样式和令牌
import 'virtual:wisp/user-css';
import { Font } from 'astro:assets';
import config from 'virtual:wisp/config';
import SkipLink from 'virtual:wisp/components/SkipLink';
import Header from 'virtual:wisp/components/Header';
import Footer from 'virtual:wisp/components/Footer';
import CopyButton from 'virtual:wisp/components/CopyButton';
import Lightbox from 'virtual:wisp/components/Lightbox';
import Citations from 'virtual:wisp/components/Citations';
import { sitePath } from '../utils/paths';

export interface Props {
  /** 页面标题；不传时只显示站点名。会自动拼成 “标题 · 站点名” */
  title?: string;
  /** meta description，默认站点描述 */
  description?: string;
  /** <html lang>，默认 config.site.lang */
  lang?: string;
  /** canonical URL（绝对或站内路径），默认当前 URL */
  canonical?: string;
  /** OG 图片（绝对或站内路径） */
  image?: string;
  /** og:type，默认 website；文章页为 article */
  type?: 'website' | 'article';
  /** 文章发布时间 / 更新时间（type=article 时输出 article:*） */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 文章标签（输出 article:tag） */
  tags?: string[];
  /** 不希望被索引（如 404、草稿预览） */
  noindex?: boolean;
  /** 页眉的书眉（running head）：文章页传入系列名、章节位置与标题 */
  running?: { label: string; href?: string; position?: string; title?: string };
}

const {
  title,
  description = config.site.description,
  lang = config.site.lang,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  running,
} = Astro.props;

const site = Astro.site ?? new URL(config.siteUrl);
const base = import.meta.env.BASE_URL;
const canonicalPath = Astro.props.canonical ?? Astro.url.pathname;
const canonical = new URL(sitePath(base, canonicalPath), site).href;
const fullTitle =
  title && title !== config.site.title ? `${title} · ${config.site.title}` : config.site.title;
const imageUrl = image ? new URL(sitePath(base, image), site).href : undefined;
const ogLocale = lang.replace('-', '_');
const needsCjkFont = /^(zh|ja|ko)\b/i.test(lang);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let s = 'system';
        try {
          s = localStorage.getItem('wisp-theme') || 'system';
        } catch {}
        const d = document.documentElement;
        const dark =
          s === 'dark' || (s !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        d.dataset.themePref = s === 'light' || s === 'dark' ? s : 'system';
      })();
    </script>
    <script is:inline>
      // 代码块自动换行的读者偏好（CopyButton 写入）：首帧前生效，避免先滚动后换行的跳动
      try {
        const w = localStorage.getItem('wisp-code-wrap');
        if (w === 'on' || w === 'off') document.documentElement.dataset.wispCodeWrap = w;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {config.site.author && <meta name="author" content={config.site.author} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath(base, '/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={new URL(sitePath(base, '/rss.xml'), site.origin).href}
    />
    <link rel="sitemap" href={sitePath(base, '/sitemap-index.xml')} />
    <Font
      cssVariable="--font-wisp-sans"
      preload={[{ subset: 'latin', weight: 400, style: 'normal' }]}
    />
    <Font cssVariable="--font-wisp-mono" />
    <meta name="generator" content={Astro.generator} />
    {needsCjkFont && <link rel="stylesheet" href={notoCssUrl} />}

    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:title" content={title ?? config.site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={description} />}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Header running={running} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    <CopyButton />
    <Citations />
    <script is:inline>
      /*
       * 横向滚动容器的溢出标记：data-wisp-overflow="start|end|both" 表示哪一侧还有没显示的内容，
       * CSS 据此在那一侧把内容渐隐（global.css）；滚到头时该侧的渐隐消失。
       * 同时：只有溢出的容器可以键盘聚焦（tabindex），并带「…，可横向滚动」的名称；不溢出时恢复原名称、
       * 去掉 tabindex——markup 里的 tabindex=0 + data-wisp-tab 只是无 JS 时的回落（rehype-a11y / shiki.ts）。
       * 代码块另记 data-wisp-wide（不换行时会溢出）——「自动换行」按钮只在这些块上出现。
       * 站点自己的横向滚动容器加 data-wisp-scroll 属性即可加入。
       */
      (() => {
        const zh = document.documentElement.lang.startsWith('zh');
        const SEL =
          '.wisp-pre, .wisp-table, .katex-display, .wisp-explainer__scroll, .wisp-pele-body, [data-wisp-scroll]';
        const side = (el) => {
          const max = el.scrollWidth - el.clientWidth;
          if (max <= 1) return '';
          const x = Math.abs(el.scrollLeft);
          return x <= 1 ? 'end' : x >= max - 1 ? 'start' : 'both';
        };
        const mark = (el) => {
          const v = side(el);
          if ((el.getAttribute('data-wisp-overflow') || '') === v) return v;
          if (v) el.setAttribute('data-wisp-overflow', v);
          else el.removeAttribute('data-wisp-overflow');
          return v;
        };
        const label = (el, overflow) => {
          // 键盘：只有溢出的容器是 Tab 停靠点。主题写的 tabindex 带 data-wisp-tab（无 JS 回落），
          // 没有 tabindex 的容器也归脚本管；站点自己写的 tabindex（没有 data-wisp-tab）保持不动
          if ('wispTab' in el.dataset || !el.hasAttribute('tabindex')) {
            el.dataset.wispTab = '';
            if (overflow) el.tabIndex = 0;
            else if (document.activeElement !== el) el.removeAttribute('tabindex');
          }
          // 名称：原始名称只记一次（data-wisp-label），每次都从它重新拼，所以反复 resize / 滚动不会叠加后缀
          if (!('wispLabel' in el.dataset))
            el.dataset.wispLabel = el.getAttribute('aria-label') || '';
          const own = el.dataset.wispLabel;
          if (!overflow) {
            if (own) el.setAttribute('aria-label', own);
            else el.removeAttribute('aria-label');
            if ('wispRole' in el.dataset) {
              el.removeAttribute('role');
              delete el.dataset.wispRole;
            }
            return;
          }
          const base =
            own ||
            (el.classList.contains('wisp-pre')
              ? zh
                ? '代码'
                : 'Code'
              : el.classList.contains('wisp-table')
                ? zh
                  ? '表格'
                  : 'Table'
                : el.classList.contains('katex-display')
                  ? zh
                    ? '公式'
                    : 'Formula'
                  : zh
                    ? '内容'
                    : 'Content');
          if (!el.hasAttribute('role')) {
            el.setAttribute('role', 'region');
            el.dataset.wispRole = '';
          }
          el.setAttribute(
            'aria-label',
            zh ? `${base}，可横向滚动` : `${base}, horizontally scrollable`,
          );
        };
        const update = () => {
          // 代码块：先在“不换行”状态下统一测量一次（批量写 → 批量读 → 批量写，只触发一次布局）
          const boxes = [...document.querySelectorAll('.wisp-code')];
          boxes.forEach((b) => b.setAttribute('data-wisp-measure', ''));
          const wide = boxes.map((b) => {
            const pre = b.querySelector('.wisp-pre');
            return !!pre && pre.scrollWidth > pre.clientWidth + 1;
          });
          boxes.forEach((b, i) => {
            b.removeAttribute('data-wisp-measure');
            b.toggleAttribute('data-wisp-wide', wide[i]);
          });
          document.querySelectorAll(SEL).forEach((el) => label(el, mark(el) !== ''));
        };
        let queued = false;
        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            update();
          });
        };
        update();
        addEventListener('resize', schedule, { passive: true });
        document.addEventListener('wisp:overflow', schedule);
        if (window.ResizeObserver) new ResizeObserver(schedule).observe(document.body);
        // 公式、思源黑体等字体换上后宽度会变，而 body 尺寸未必变
        document.fonts?.ready.then(schedule);
        // 滚动事件不冒泡：在捕获阶段统一接住，每个容器每帧最多更新一次
        const pending = new Set();
        document.addEventListener(
          'scroll',
          (e) => {
            const el = e.target;
            if (!(el instanceof Element) || !el.matches(SEL)) return;
            if (pending.has(el)) return;
            pending.add(el);
            requestAnimationFrame(() => {
              pending.delete(el);
              mark(el);
            });
          },
          { capture: true, passive: true },
        );
      })();
    </script>
  </body>
</html>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    main {
      display: block;
      outline: none;
    }
  }
</style>
