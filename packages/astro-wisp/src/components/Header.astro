---
/**
 * 顶栏：高 64px，吸顶。左侧站点名，右侧导航与主题切换。
 */
import config from 'virtual:wisp/config';
import ThemeToggle from 'virtual:wisp/components/ThemeToggle';
import { sitePath } from '../utils/paths';

export interface Props {
  /** 当前路径，用于给导航项加 aria-current；默认取 Astro.url.pathname */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const base = import.meta.env.BASE_URL;
const routePath = currentPath.startsWith(base) ? `/${currentPath.slice(base.length).replace(/^\/+/, '')}` : currentPath;
const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isCurrent = (href: string) => href !== '/' && norm(decodeURI(routePath)).startsWith(norm(href));
---

<header class="wisp-header">
  <div class="wisp-container wisp-header-inner">
    <a href={sitePath(base, '/')} class="wisp-brand" aria-current={routePath === '/' ? 'page' : undefined}>{config.site.title}</a>
    <nav aria-label="主导航" class="wisp-nav">
      <ul>
        {
          config.nav.map((item) => (
            <li>
              <a href={sitePath(base, item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  /* 顶栏在长文阅读时保留位置感，同时用实色背景避免内容穿透。 */
  .wisp-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--wisp-bg);
    border-bottom: 1px solid var(--wisp-border);
  }
  .wisp-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }
  .wisp-brand {
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    color: var(--wisp-fg);
    white-space: nowrap;
  }
  .wisp-nav {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.5rem;
  }
  .wisp-nav ul {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .wisp-nav ul::-webkit-scrollbar {
    display: none;
  }
  .wisp-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--wisp-muted);
    font-size: 0.875rem;
    transition: color 150ms, background-color 150ms, border-color 150ms;
    white-space: nowrap;
  }
  .wisp-nav a:hover {
    color: var(--wisp-fg);
    background-color: var(--wisp-surface);
    border-color: var(--wisp-border);
  }
  /* 与侧栏当前项高亮语言一致：accent 色 */
  .wisp-nav a[aria-current='page'] {
    color: var(--wisp-accent);
    background-color: var(--wisp-surface);
    border-color: var(--wisp-border);
  }
  @media (max-width: 23.99rem) {
    .wisp-header-inner {
      gap: 0.5rem;
    }
    .wisp-brand {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .wisp-nav {
      gap: 0.25rem;
    }
    .wisp-nav ul {
      gap: 0.875rem;
    }
  }
  }
</style>
