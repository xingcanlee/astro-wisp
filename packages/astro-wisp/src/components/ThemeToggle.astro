---
/**
 * 主题切换按钮：light → dark → system 循环。
 * 当前偏好由 head 内联脚本写入 `<html data-theme-pref>`，图标据此用 CSS 显示，首屏无跳变。
 * 本组件无 props。
 */
import Icon from 'virtual:wisp/components/Icon';

export type Props = Record<string, never>;
---

<button type="button" class="wisp-theme-toggle" data-wisp-theme-toggle aria-label="切换主题">
  <Icon name="sun" size={18} class="i-light" />
  <Icon name="moon" size={18} class="i-dark" />
  <span class="i-auto" aria-hidden="true">
    A
  </span>
</button>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-theme-toggle {
      display: inline-grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-inline-end: -0.5rem;
      border: 0;
      border-radius: 4px;
      background: transparent;
      color: var(--wisp-muted);
      cursor: pointer;
      transition:
        color 150ms,
        background-color 150ms;
    }
    .wisp-theme-toggle:hover {
      color: var(--wisp-fg);
      background-color: var(--wisp-surface);
    }
    .wisp-theme-toggle {
      position: relative;
    }
    .wisp-theme-toggle:active :global(svg) {
      transform: scale(0.9);
    }
    /* 图标显示当前实际的明暗（太阳 / 月亮），跟随系统时右下角多一个小 A 角标 */
    .wisp-theme-toggle :global(svg) {
      display: none;
      transition: transform 160ms var(--wisp-ease);
    }
    :global(html[data-theme='light']) .wisp-theme-toggle :global(.i-light),
    :global(html[data-theme='dark']) .wisp-theme-toggle :global(.i-dark) {
      display: block;
    }
    .i-auto {
      display: none;
      position: absolute;
      right: 0.45rem;
      bottom: 0.45rem;
      min-width: 0.8rem;
      height: 0.8rem;
      padding-inline: 2px;
      border-radius: 3px;
      background: var(--wisp-surface-2);
      color: var(--wisp-fg);
      font-size: 0.5625rem;
      font-weight: 700;
      line-height: 0.8rem;
      text-align: center;
    }
    :global(html:not([data-theme-pref='light']):not([data-theme-pref='dark']))
      .wisp-theme-toggle
      .i-auto {
      display: block;
    }
  }
</style>

<script>
  const d = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const names: Record<string, string> = { light: '浅色', dark: '深色', system: '跟随系统' };
  const next: Record<string, string> = { light: 'dark', dark: 'system', system: 'light' };
  let pref = names[d.dataset.themePref!] ? d.dataset.themePref! : 'system';
  const apply = () => {
    d.dataset.themePref = pref;
    d.dataset.theme = pref === 'dark' || (pref === 'system' && mq.matches) ? 'dark' : 'light';
    document
      .querySelectorAll('[data-wisp-theme-toggle]')
      .forEach((b) =>
        b.setAttribute('aria-label', `主题：${names[pref]}（点击切换为${names[next[pref]!]}）`),
      );
  };
  apply();
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest?.('[data-wisp-theme-toggle]')) return;
    pref = next[pref]!;
    try {
      localStorage.setItem('wisp-theme', pref);
    } catch {}
    apply();
  });
  mq.addEventListener('change', () => pref === 'system' && apply());
  addEventListener('storage', (e) => {
    if (e.key === 'wisp-theme') {
      pref = e.newValue && names[e.newValue] ? e.newValue : 'system';
      apply();
    }
  });
</script>
