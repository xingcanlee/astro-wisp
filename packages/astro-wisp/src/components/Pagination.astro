---
/**
 * 分页导航：上一页 / 第 n / N 页 / 下一页。
 * URL 规则：第 1 页为 `base`，第 n 页为 `${base}page/${n}/`；也可直接传 prevUrl / nextUrl（例如来自 Astro paginate() 的 page.url）。
 */
export interface Props {
  /** 当前页（从 1 开始） */
  current: number;
  /** 总页数 */
  total: number;
  /** 第 1 页的 URL，默认 `/` */
  base?: string;
  /** 覆盖上一页 URL */
  prevUrl?: string;
  /** 覆盖下一页 URL */
  nextUrl?: string;
}

import Icon from 'virtual:wisp/components/Icon';
import config from 'virtual:wisp/config';
import { sitePath } from '../utils/paths';

const { current, total, base = '/' } = Astro.props;
const zh = /^zh\b/i.test(config.site.lang);
const root = `${sitePath(import.meta.env.BASE_URL, base).replace(/\/+$/, '')}/`;
const urlOf = (n: number) => (n <= 1 ? root : `${root}page/${n}/`);
const prevUrl = Astro.props.prevUrl ?? (current > 1 ? urlOf(current - 1) : undefined);
const nextUrl = Astro.props.nextUrl ?? (current < total ? urlOf(current + 1) : undefined);
---

{total > 1 && (
  <nav class="wisp-pagination" aria-label="分页">
    {prevUrl ? (
      <a href={prevUrl} rel="prev">
        <Icon name="arrow-left" /> {zh ? '上一页' : 'Previous'}
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
    <span class="wisp-pagination-cur" aria-current="page">
      {zh ? `第 ${current} / ${total} 页` : `Page ${current} of ${total}`}
    </span>
    {nextUrl ? (
      <a href={nextUrl} rel="next">
        {zh ? '下一页' : 'Next'} <Icon name="arrow-right" />
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
  </nav>
)}

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-pagination {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: baseline;
      gap: 1rem;
      margin-top: 4rem;
      font-size: 0.9375rem;
    }
    .wisp-pagination a {
      color: var(--wisp-accent);
      transition: color 150ms;
    }
    .wisp-pagination a:hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
    .wisp-pagination > :last-child {
      justify-self: end;
    }
    .wisp-pagination-cur {
      color: var(--wisp-muted);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }
  }
</style>
