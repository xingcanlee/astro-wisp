---
/**
 * 页脚：与顶栏同一外框（.wisp-shell）的一行收尾。
 * 只放顶栏没有的信息：左侧版权，右侧 GitHub 与订阅入口。导航和系列入口已在顶栏、首页和文章侧栏里，不再重复。
 */
import config from 'virtual:wisp/config';
import Icon from 'virtual:wisp/components/Icon';
import { sitePath } from '../utils/paths';

export interface Props {
  /** 版权年份，默认当前构建年份 */
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
const defaultLabel: Record<string, string> = {
  github: 'GitHub',
  x: 'X',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
  email: '邮箱',
  rss: 'RSS',
  link: '链接',
};
const iconOf: Record<string, string> = {
  github: 'github',
  rss: 'rss',
  x: 'twitter',
  email: 'mail',
  mastodon: 'at-sign',
  bluesky: 'at-sign',
  link: 'link',
};
const owner = config.site.author || config.site.title;
const zh = /^zh\b/i.test(config.site.lang);
const base = import.meta.env.BASE_URL;
---

<footer class="wisp-footer">
  <div class="wisp-shell">
    <div class="wisp-footer-inner">
      <p class="wisp-footer-copy">© {year} {owner}</p>
      {
        (config.site.authorGithub || config.social.length > 0) && (
          <ul class="wisp-footer-links" aria-label={zh ? '社交与订阅' : 'Social and feed links'}>
            {config.site.authorGithub && (
              <li>
                <a href={config.site.authorGithub} rel="me noopener" aria-label="GitHub" title="GitHub">
                  <Icon name="github" size={18} />
                </a>
              </li>
            )}
            {config.social.length > 0 && (
              <>
                {config.social.map((s) => {
                  const external = /^https?:/.test(s.href);
                  const href =
                    s.kind === 'email' && !s.href.startsWith('mailto:')
                      ? `mailto:${s.href}`
                      : sitePath(base, s.href);
                  const label = s.label ?? defaultLabel[s.kind];
                  return (
                    <li>
                      <a
                        href={href}
                        rel={external ? 'me noopener' : undefined}
                        type={s.kind === 'rss' ? 'application/rss+xml' : undefined}
                        aria-label={label}
                        title={label}
                      >
                        <Icon name={iconOf[s.kind] ?? 'link'} size={18} />
                      </a>
                    </li>
                  );
                })}
              </>
            )}
          </ul>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  .wisp-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--wisp-border);
    color: var(--wisp-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .wisp-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 0.75rem;
  }
  .wisp-footer-copy {
    margin: 0;
  }
  .wisp-footer-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0 -0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wisp-footer-links a {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
    color: var(--wisp-muted);
    transition: color 150ms, background-color 150ms;
  }
  .wisp-footer-links a:hover {
    color: var(--wisp-accent);
    background-color: var(--wisp-surface);
  }
  }
</style>
