---
/**
 * 页脚：与顶栏同一外框（.wisp-shell）。
 * 上半部分：站点名与描述、系列入口、站点导航；下半部分：版权与 GitHub / 订阅图标。
 * 读完一篇文章时，这里是去下一处的地方。
 */
import config from 'virtual:wisp/config';
import Icon from 'virtual:wisp/components/Icon';
import { sitePath } from '../utils/paths';
import { getPosts, summarizeSeries } from '../utils/posts';

export interface Props {
  /** 版权年份，默认当前构建年份 */
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
const defaultLabel: Record<string, string> = {
  github: 'GitHub',
  x: 'X',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
  email: '邮箱',
  rss: 'RSS',
  link: '链接',
};
const iconOf: Record<string, string> = {
  github: 'github',
  rss: 'rss',
  x: 'twitter',
  email: 'mail',
  mastodon: 'at-sign',
  bluesky: 'at-sign',
  link: 'link',
};
const owner = config.site.author || config.site.title;
const zh = /^zh\b/i.test(config.site.lang);
const base = import.meta.env.BASE_URL;
const series = summarizeSeries(await getPosts()).slice(0, 6);
---

<footer class="wisp-footer">
  <div class="wisp-shell">
    <div class="wisp-footer-top">
      <div class="wisp-footer-about">
        <a href={sitePath(base, '/')} class="wisp-footer-brand">{config.site.title}</a>
        {config.site.description && <p>{config.site.description}</p>}
      </div>
      {
        series.length > 0 && (
          <nav class="wisp-footer-col" aria-labelledby="wisp-footer-series">
            <p id="wisp-footer-series" class="wisp-eyebrow">{zh ? '系列' : 'Series'}</p>
            <ul>
              {series.map((s) => (
                <li>
                  <a href={sitePath(base, `/posts/${s.firstId}/`)}>
                    <span class="wisp-draw">{s.title.split(/[：:]/)[0]}</span>
                    <span class="wisp-footer-count">{s.items.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        config.nav.length > 0 && (
          <nav class="wisp-footer-col" aria-labelledby="wisp-footer-site">
            <p id="wisp-footer-site" class="wisp-eyebrow">{zh ? '站点' : 'Site'}</p>
            <ul>
              {config.nav.map((item) => (
                <li>
                  <a href={sitePath(base, item.href)}>
                    <span class="wisp-draw">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
    <div class="wisp-footer-inner">
      <p class="wisp-footer-copy">© {year} {owner}</p>
      {
        (config.site.authorGithub || config.social.length > 0) && (
          <ul class="wisp-footer-links" aria-label={zh ? '社交与订阅' : 'Social and feed links'}>
            {config.site.authorGithub && (
              <li>
                <a href={config.site.authorGithub} rel="me noopener" aria-label="GitHub" title="GitHub">
                  <Icon name="github" size={18} />
                </a>
              </li>
            )}
            {config.social.length > 0 && (
              <>
                {config.social.map((s) => {
                  const external = /^https?:/.test(s.href);
                  const href =
                    s.kind === 'email' && !s.href.startsWith('mailto:')
                      ? `mailto:${s.href}`
                      : sitePath(base, s.href);
                  const label = s.label ?? defaultLabel[s.kind];
                  return (
                    <li>
                      <a
                        href={href}
                        rel={external ? 'me noopener' : undefined}
                        type={s.kind === 'rss' ? 'application/rss+xml' : undefined}
                        aria-label={label}
                        title={label}
                      >
                        <Icon name={iconOf[s.kind] ?? 'link'} size={18} />
                      </a>
                    </li>
                  );
                })}
              </>
            )}
          </ul>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  .wisp-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--wisp-border);
    background: var(--wisp-surface);
    color: var(--wisp-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .wisp-footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 1.5rem;
    padding-block: 3rem 2.5rem;
  }
  @media (min-width: 48rem) {
    .wisp-footer-top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--wisp-gutter);
    }
  }
  .wisp-footer-about {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .wisp-footer-about {
      grid-column: auto;
    }
  }
  .wisp-footer-about p {
    max-width: 26rem;
    margin: 0.5rem 0 0;
  }
  .wisp-footer-brand {
    color: var(--wisp-fg);
    font-size: 1rem;
    font-weight: 650;
  }
  .wisp-footer-col ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wisp-footer-col a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding-block: 0.4rem;
    color: var(--wisp-fg);
    transition: color 150ms;
  }
  .wisp-footer-col a:hover {
    color: var(--wisp-accent);
  }
  .wisp-footer-count {
    color: var(--wisp-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .wisp-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--wisp-border);
  }
  .wisp-footer-copy {
    margin: 0;
  }
  .wisp-footer-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0 -0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wisp-footer-links a {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
    color: var(--wisp-muted);
    transition: color 150ms, background-color 150ms, transform 160ms var(--wisp-ease);
  }
  .wisp-footer-links a:hover {
    color: var(--wisp-accent);
    background-color: var(--wisp-surface-2);
    transform: translateY(-1px);
  }
  }
</style>
