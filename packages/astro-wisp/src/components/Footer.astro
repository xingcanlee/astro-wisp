---
/**
 * 页脚：版权、RSS、社交链接。muted，0.875rem。
 */
import config from 'virtual:wisp/config';
import Icon from 'virtual:wisp/components/Icon';
import { sitePath } from '../utils/paths';

export interface Props {
  /** 版权年份，默认当前构建年份 */
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
const defaultLabel: Record<string, string> = {
  github: 'GitHub',
  x: 'X',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
  email: '邮箱',
  rss: 'RSS',
  link: '链接',
};
const iconOf: Record<string, string> = {
  github: 'github',
  rss: 'rss',
  x: 'twitter',
  email: 'mail',
  mastodon: 'at-sign',
  bluesky: 'at-sign',
  link: 'link',
};
const owner = config.site.author || config.site.title;
const zh = /^zh\b/i.test(config.site.lang);
---

<footer class="wisp-footer">
  <div class="wisp-container">
  <div class="wisp-footer-inner">
    <p>
      © {year}{' '}
      {
        config.site.authorGithub ? (
          <a class="wisp-footer-author" href={config.site.authorGithub} rel="me noopener">{owner}</a>
        ) : (
          owner
        )
      }
    </p>
    {
      config.social.length > 0 && (
        <ul aria-label={zh ? '社交链接' : 'Social links'}>
          {config.social.map((s) => {
            const external = /^https?:/.test(s.href);
            const href = s.kind === 'email' && !s.href.startsWith('mailto:') ? `mailto:${s.href}` : sitePath(import.meta.env.BASE_URL, s.href);
            return (
              <li>
                <a
                  href={href}
                  rel={external ? 'me noopener' : undefined}
                  type={s.kind === 'rss' ? 'application/rss+xml' : undefined}
                  aria-label={s.label ?? defaultLabel[s.kind]}
                  title={s.label ?? defaultLabel[s.kind]}
                >
                  <Icon name={iconOf[s.kind] ?? 'link'} size={18} />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
  </div>
</footer>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  .wisp-footer {
    margin-top: 6rem;
    color: var(--wisp-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .wisp-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--wisp-border);
  }
  .wisp-footer p {
    margin: 0;
  }
  .wisp-footer p .wisp-footer-author {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.25rem;
    width: auto;
    height: auto;
    border-radius: 0;
    color: inherit;
  }
  .wisp-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 -0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wisp-footer a {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
    color: var(--wisp-muted);
    transition: color 150ms;
  }
  .wisp-footer a:hover {
    color: var(--wisp-accent);
  }
  }
</style>
