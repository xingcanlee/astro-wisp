---
/**
 * 系列文章导航：宽屏放在正文左侧，窄屏折叠到正文前。
 * 路由层负责按 series.order 排好序，组件只负责展示当前文章和链接。
 */
import Icon from 'virtual:wisp/components/Icon';
import config from 'virtual:wisp/config';
import { sitePath } from '../utils/paths';

export interface SeriesItem {
  id: string;
  title: string;
  order: number;
}

export interface Props {
  items: SeriesItem[];
  currentId: string;
  variant?: 'aside' | 'inline';
  title?: string;
}

const { items, currentId, variant = 'aside', title = (/^zh\b/i.test(config.site.lang) ? '系列文章' : 'Series') } = Astro.props;
const headingId = variant === 'aside' ? 'wisp-series-title-aside' : 'wisp-series-title-inline';
const currentIndex = items.findIndex((item) => item.id === currentId);
const position = currentIndex >= 0
  ? (/^zh\b/i.test(config.site.lang) ? `第 ${currentIndex + 1}/${items.length} 篇` : `${currentIndex + 1}/${items.length}`)
  : '';
const inlineTitle = position ? `${title} · ${position}` : title;
---

{
  items.length > 0 &&
    (variant === 'inline' ? (
      <details class="wisp-series wisp-series-inline">
        <summary>
          <Icon name="chevron-right" class="wisp-series-chev" />
          {inlineTitle}
        </summary>
        <ol>
          {items.map((item) => (
            <li>
              <a
                href={sitePath(import.meta.env.BASE_URL, `/posts/${item.id}/`)}
                aria-current={item.id === currentId ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class="wisp-series wisp-series-aside" aria-labelledby={headingId}>
        <p id={headingId} class="wisp-series-title">
          <span>{title}</span>
          <span class="wisp-series-count">{currentIndex >= 0 ? `${currentIndex + 1} / ${items.length}` : items.length}</span>
        </p>
        <ol>
          {items.map((item) => (
            <li>
              <a
                href={sitePath(import.meta.env.BASE_URL, `/posts/${item.id}/`)}
                aria-current={item.id === currentId ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}

<style>
  @layer components {
  .wisp-series {
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .wisp-series ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wisp-series li {
    margin: 0;
  }
  .wisp-series a {
    display: block;
    padding-block: 0.3rem;
    color: var(--wisp-muted);
    transition:
      color 150ms,
      border-color 150ms;
  }
  .wisp-series a:hover {
    color: var(--wisp-fg);
  }
  .wisp-series a[aria-current='page'] {
    color: var(--wisp-accent);
  }
  /* 侧栏：与目录同一种写法——左侧细轨道，当前项强调色竖条 + 浅底 */
  .wisp-series-aside ol {
    border-inline-start: 1px solid var(--wisp-border);
  }
  .wisp-series-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    color: var(--wisp-fg);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.01em;
  }
  .wisp-series-count {
    flex: none;
    color: var(--wisp-muted);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .wisp-series-aside a {
    margin-inline-start: -1px;
    padding: 0.35rem 0.5rem 0.35rem 0.875rem;
    border-inline-start: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    transition:
      color 150ms,
      background-color 150ms,
      border-color 150ms;
  }
  .wisp-series-aside a:hover {
    background-color: var(--wisp-surface);
  }
  .wisp-series-aside a[aria-current='page'] {
    border-inline-start-color: var(--wisp-accent);
    background-color: var(--wisp-surface);
    color: var(--wisp-fg);
    font-weight: 500;
  }
  .wisp-series-inline {
    margin: 0 0 2.5rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--wisp-border);
  }
  .wisp-series-inline summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--wisp-muted);
    font-weight: 600;
    list-style: none;
    transition: color 150ms;
  }
  .wisp-series-inline summary::-webkit-details-marker {
    display: none;
  }
  .wisp-series-inline summary:hover,
  .wisp-series-inline[open] summary {
    color: var(--wisp-fg);
  }
  .wisp-series-inline[open] summary :global(.wisp-series-chev) {
    transform: rotate(90deg);
  }
  .wisp-series-inline ol {
    /* 长系列（几十篇）展开时限制高度，避免把正文推出一屏 */
    max-height: 60vh;
    overflow-y: auto;
    margin-top: 0.5rem;
  }
  .wisp-series :global(.wisp-series-chev) {
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wisp-series :global(.wisp-series-chev) {
      transition: transform 150ms;
    }
  }
  }
</style>
