---
/**
 * 文章页底部的上一篇 / 下一篇。
 * 普通文章按发布时间排列；系列文章由路由层按 series.order 传入相邻章节。
 */
export interface PrevNextItem {
  /** 文章 id，链接为 /posts/<id>/ */
  id: string;
  title: string;
}

export interface Props {
  prev?: PrevNextItem;
  next?: PrevNextItem;
  lang?: string;
}

import Icon from 'virtual:wisp/components/Icon';
import config from 'virtual:wisp/config';
import { sitePath } from '../utils/paths';

const { prev, next, lang = config.site.lang } = Astro.props;
const zh = /^zh\b/i.test(lang);
---

{
  (prev || next) && (
    <nav class="wisp-prevnext" aria-label={zh ? '相邻文章' : 'Adjacent articles'}>
      {prev ? (
        <a href={sitePath(import.meta.env.BASE_URL, `/posts/${prev.id}/`)} rel="prev" class="is-prev">
          <span class="label"><Icon name="arrow-left" /> {zh ? '上一篇' : 'Previous'}</span>
          <span class="title">{prev.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={sitePath(import.meta.env.BASE_URL, `/posts/${next.id}/`)} rel="next" class="is-next">
          <span class="label">{zh ? '下一篇' : 'Next'} <Icon name="arrow-right" /></span>
          <span class="title">{next.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  .wisp-prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }
  /* 两张卡片：悬停上移 2px、边框转强调色、箭头往外挪一点 */
  .wisp-prevnext a {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
    padding: 1rem 1.25rem 1.125rem;
    border: 1px solid var(--wisp-border);
    border-radius: 12px;
    transition:
      transform 200ms var(--wisp-ease),
      border-color 200ms,
      background-color 200ms;
  }
  .wisp-prevnext a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--wisp-accent) 50%, var(--wisp-border));
    background-color: var(--wisp-surface);
  }
  .is-next {
    text-align: end;
    grid-column: 2;
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--wisp-muted);
    font-size: 0.8125rem;
  }
  .is-next .label {
    justify-content: flex-end;
  }
  .label :global(.wisp-icon) {
    transition: transform 200ms var(--wisp-ease);
  }
  .is-prev:hover .label :global(.wisp-icon) {
    transform: translateX(-3px);
  }
  .is-next:hover .label :global(.wisp-icon) {
    transform: translateX(3px);
  }
  .title {
    color: var(--wisp-fg);
    font-weight: 600;
    line-height: 1.5;
    transition: color 150ms;
    text-wrap: pretty;
  }
  .wisp-prevnext a:hover .title {
    color: var(--wisp-accent);
  }
  @media (max-width: 39.99rem) {
    .wisp-prevnext {
      grid-template-columns: 1fr;
    }
    .is-next {
      grid-column: 1;
    }
  }
  }
</style>
