---
/**
 * 文章页底部的上一篇 / 下一篇。
 * 普通文章按发布时间排列；系列文章由路由层按 series.order 传入相邻章节。
 */
export interface PrevNextItem {
  /** 文章 id，链接为 /posts/<id>/ */
  id: string;
  title: string;
}

export interface Props {
  prev?: PrevNextItem;
  next?: PrevNextItem;
  lang?: string;
}

import Icon from 'virtual:wisp/components/Icon';
import config from 'virtual:wisp/config';
import { sitePath } from '../utils/paths';

const { prev, next, lang = config.site.lang } = Astro.props;
const zh = /^zh\b/i.test(lang);
---

{(prev || next) && (
  <nav class="wisp-prevnext" aria-label={zh ? '相邻文章' : 'Adjacent articles'}>
    {prev ? (
      <a href={sitePath(import.meta.env.BASE_URL, `/posts/${prev.id}/`)} rel="prev" class="is-prev">
        <span class="label">
          <Icon name="arrow-left" /> {zh ? '上一篇' : 'Previous'}
        </span>
        <span class="title">{prev.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={sitePath(import.meta.env.BASE_URL, `/posts/${next.id}/`)} rel="next" class="is-next">
        <span class="label">
          {zh ? '下一篇' : 'Next'} <Icon name="arrow-right" />
        </span>
        <span class="title">{next.title}</span>
      </a>
    ) : (
      <span />
    )}
  </nav>
)}

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    /* 章末：一条前景色细线收住全文，下面左右两格是上一篇 / 下一篇（不做卡片） */
    .wisp-prevnext {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
      margin-top: 4rem;
      border-top: 1px solid var(--wisp-fg);
    }
    .wisp-prevnext a {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-width: 0;
      padding-block: 1rem 0.5rem;
    }
    .is-next {
      text-align: end;
      grid-column: 2;
    }
    .label {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--wisp-muted);
      font-size: 0.8125rem;
      transition: color 150ms;
    }
    .wisp-prevnext a:hover .label {
      color: var(--wisp-accent);
    }
    .is-next .label {
      justify-content: flex-end;
    }
    .label :global(.wisp-icon) {
      transition: transform 200ms var(--wisp-ease);
    }
    .is-prev:hover .label :global(.wisp-icon) {
      transform: translateX(-3px);
    }
    .is-next:hover .label :global(.wisp-icon) {
      transform: translateX(3px);
    }
    .title {
      color: var(--wisp-fg);
      font-weight: 600;
      line-height: 1.5;
      transition: color 150ms;
      text-wrap: pretty;
    }
    .wisp-prevnext a:hover .title {
      color: var(--wisp-accent);
    }
    @media (max-width: 39.99rem) {
      .wisp-prevnext {
        grid-template-columns: 1fr;
      }
      .is-next {
        grid-column: 1;
        border-top: 1px solid var(--wisp-border);
      }
    }
  }
</style>
