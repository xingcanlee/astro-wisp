---
/**
 * 通用图片/图形容器：<figure class="wisp-figure"> + 图下题注（与图表、Mermaid、Markdown 图片同一套题注样式，见 figure.css）。
 * 传 `src` 时渲染图片（本地 ImageMetadata 走 astro:assets 优化，figure 带 .wisp-image，位图有发丝线描边）；
 * 否则渲染默认插槽（SVG、组件等）。`caption` 以「图 3：」「Figure 2.」开头时图号单独排成 .wisp-fig-no；
 * 具名插槽 `caption` 原样输出（需要图号样式时自己写 <span class="wisp-fig-no">）。
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { figureCaptionHtml } from '../plugins/figure-caption';

export interface Props {
  /** 图片：本地导入的 ImageMetadata 或 URL 字符串 */
  src?: ImageMetadata | string;
  /** 替代文本；传 src 时必填（纯装饰可传空字符串） */
  alt?: string;
  /** 图注文字；也可用具名插槽 `caption` */
  caption?: string;
  /** 是否突破正文宽度（.wisp-wide） */
  wide?: boolean;
  /** 字符串 URL 图片的尺寸（可选，防止布局偏移） */
  width?: number;
  height?: number;
  /** 额外 class */
  class?: string;
}

const { src, alt = '', caption, wide = false, width, height, class: className } = Astro.props;
const hasCaptionSlot = Astro.slots.has('caption');
---

<figure class:list={['wisp-figure', { 'wisp-image': src, 'wisp-wide': wide }, className]}>
  {src ? (
    typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} />
    )
  ) : (
    <slot />
  )}
  {(caption || hasCaptionSlot) && (
    <figcaption>
      {hasCaptionSlot ? (
        <slot name="caption" />
      ) : (
        <Fragment set:html={figureCaptionHtml(caption!)} />
      )}
    </figcaption>
  )}
</figure>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-figure :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
      margin-inline: auto;
      border-radius: 4px;
    }
  }
</style>
