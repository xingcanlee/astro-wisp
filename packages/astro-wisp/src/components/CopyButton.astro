---
/**
 * 代码块的客户端按钮：自动换行（只在横向溢出的块上显示）、复制、长代码折叠。
 * 换行是读者偏好：html[data-wisp-code-wrap="on|off"] + localStorage `wisp-code-wrap`，对整页代码块生效；
 * 首帧前的初值由 Base 布局 <head> 里的内联脚本写入。
 */
import wisp from 'virtual:wisp/config';
import { iconSvg } from '../lib/icons';

const copy = wisp.features.codeCopy;
const fold = wisp.features.codeFold.enabled;
const ic = (n: string) => `<span data-i="${n}">${iconSvg(n)}</span>`;
const icons = [
  'wrap-text',
  ...(copy ? ['copy', 'check'] : []),
  ...(fold ? ['chevron-down', 'chevron-up'] : []),
]
  .map(ic)
  .join('');
---

<>
  <template id="wisp-ic" set:html={icons} />
  <script is:inline>
    (() => {
      const T = document.getElementById('wisp-ic');
      const I = (n) => T.content.querySelector('[data-i="' + n + '"]')?.innerHTML;
      const root = document.documentElement;
      const zh = root.lang.startsWith('zh');
      // 当前是否换行：读者选择优先，否则看站点默认（.wisp-code--wrap）
      const wrapped = (box) =>
        root.dataset.wispCodeWrap
          ? root.dataset.wispCodeWrap === 'on'
          : box.classList.contains('wisp-code--wrap');
      const syncWrap = () =>
        document
          .querySelectorAll('.wisp-wrap')
          .forEach((b) => b.setAttribute('aria-pressed', String(wrapped(b.parentElement))));
      document.querySelectorAll('.wisp-code').forEach((box, k) => {
        const pre = box.querySelector('pre');
        const el = (t, c) => Object.assign(document.createElement(t), { className: c });
        pre.id ||= 'wisp-c' + k;
        const w = el('button', 'wisp-wrap');
        w.type = 'button';
        w.innerHTML = I('wrap-text');
        w.setAttribute('aria-label', zh ? '自动换行' : 'Wrap lines');
        w.setAttribute('aria-controls', pre.id);
        w.onclick = () => {
          const next = !wrapped(box);
          // 换行会改变上方代码块的高度：保持被点的按钮停在原处
          const top = w.getBoundingClientRect().top;
          root.dataset.wispCodeWrap = next ? 'on' : 'off';
          try {
            localStorage.setItem('wisp-code-wrap', root.dataset.wispCodeWrap);
          } catch {}
          syncWrap();
          document.dispatchEvent(new Event('wisp:overflow'));
          scrollBy(0, w.getBoundingClientRect().top - top);
        };
        box.append(w);
        if (I('copy')) {
          const b = el('button', 'wisp-copy');
          const s = el('span', 'wisp-sr');
          b.type = 'button';
          b.innerHTML = I('copy');
          b.setAttribute('aria-label', zh ? '复制代码' : 'Copy code');
          s.setAttribute('role', 'status');
          s.setAttribute('aria-live', 'polite');
          b.onclick = async () => {
            const c = pre.querySelector('code').cloneNode(true);
            c.querySelectorAll('[style*="user-select"]').forEach((e) => e.remove());
            const text = c.textContent ?? '';
            let copied = false;
            try {
              if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
                copied = true;
              }
            } catch {}
            if (!copied) {
              const fallback = document.createElement('textarea');
              fallback.value = text;
              fallback.setAttribute('readonly', '');
              fallback.style.cssText = 'position:fixed;inset:-9999px;opacity:0';
              document.body.append(fallback);
              fallback.select();
              try {
                const execCopy = Reflect.get(document, 'execCommand');
                copied = Boolean(execCopy?.call(document, 'copy'));
              } catch {}
              fallback.remove();
            }
            if (!copied) {
              s.textContent = document.documentElement.lang.startsWith('zh')
                ? '复制失败'
                : 'Copy failed';
              return;
            }
            b.innerHTML = I('check');
            b.dataset.done = '';
            s.textContent = document.documentElement.lang.startsWith('zh') ? '已复制' : 'Copied';
            setTimeout(() => {
              b.innerHTML = I('copy');
              delete b.dataset.done;
              s.textContent = '';
            }, 2000);
          };
          box.append(b, s);
        }
        const n = +box.dataset.fold;
        if (n && I('chevron-down')) {
          const f = el('button', 'wisp-fold');
          const set = (open) => {
            box.toggleAttribute('data-folded', !open);
            f.setAttribute('aria-expanded', open);
            const zh = document.documentElement.lang.startsWith('zh');
            f.innerHTML =
              I(open ? 'chevron-up' : 'chevron-down') +
              '<span>' +
              (open
                ? zh
                  ? '收起'
                  : 'Collapse'
                : zh
                  ? '展开全部 ' + box.dataset.lines + ' 行'
                  : 'Show all ' + box.dataset.lines + ' lines') +
              '</span>';
          };
          f.type = 'button';
          f.setAttribute('aria-controls', pre.id);
          box.style.setProperty('--fold', n);
          set(false);
          f.onclick = () => {
            const open = box.hasAttribute('data-folded');
            set(open);
            if (open) return;
            // 收起：在长代码底部点「收起」后，代码块顶端多半已在视口上方——把它拉回页眉下方
            // （scrollIntoView 遵守 html 的 scroll-padding-top），读者回到这段代码的开头；焦点留在按钮上
            const pad =
              parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
            const top = box.getBoundingClientRect().top;
            const r = f.getBoundingClientRect();
            if (top < pad || r.bottom > innerHeight)
              box.scrollIntoView({
                block: 'start',
                behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
                  ? 'instant'
                  : 'smooth',
              });
          };
          box.append(f);
        }
      });
      syncWrap();
    })();
  </script>
</>
