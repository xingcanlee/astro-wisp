---
import Base from 'virtual:wisp/components/Base';
import PostCard from 'virtual:wisp/components/PostCard';
import Pagination from 'virtual:wisp/components/Pagination';
import { getPosts } from '../utils/posts';
import { getReadingTimes } from '../utils/reading';
import config from 'virtual:wisp/config';

const all = await getPosts();
const featured = all.filter((p) => p.data.featured).slice(0, config.home.featuredCount);
const featuredIds = new Set(featured.map((p) => p.id));
// “最新文章”不再重复展示精选区的文章（第 1 页补足 pageSize 篇）
const latest = all.filter((p) => !featuredIds.has(p.id));
const posts = latest.slice(0, config.home.pageSize);
const totalPages = Math.max(1, Math.ceil(latest.length / config.home.pageSize));
const [featuredTimes, times] = await Promise.all([getReadingTimes(featured), getReadingTimes(posts)]);
---

<Base>
  <div class="wisp-container home">
    <header class="home-intro">
      <h1>{config.site.title}</h1>
      <p>{config.site.description}</p>
    </header>
    {
      featured.length > 0 && (
        <section class="home-featured" aria-labelledby="featured-title">
          <h2 id="featured-title" class="home-label">精选</h2>
          <ul class="home-list">
            {featured.map((post, i) => (
              <li>
                <PostCard post={post} readingTime={featuredTimes[i]} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section aria-labelledby="latest-title">
      <h2 id="latest-title" class="home-label">最新文章</h2>
      <ul class="home-list">
        {
          posts.map((post, i) => (
            <li>
              <PostCard post={post} readingTime={times[i]} headingLevel={3} />
            </li>
          ))
        }
      </ul>
    </section>
    <Pagination current={1} total={totalPages} />
  </div>
</Base>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
  .home {
    padding-top: 3.5rem;
  }
  .home-intro {
    max-width: 50rem;
    margin-bottom: 3rem;
  }
  .home-intro h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: -0.02em;
  }
  .home-intro p {
    max-width: 36rem;
    margin: 0.75rem 0 0;
    color: var(--wisp-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .home-label {
    margin: 0 0 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--wisp-fg);
  }
  .home-featured {
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: var(--wisp-surface);
    border: 1px solid var(--wisp-border);
    border-radius: 12px;
  }
  .home-featured .home-list {
    gap: 1.5rem;
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .home-list {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  }
</style>
