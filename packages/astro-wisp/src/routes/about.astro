---
import { getEntry, render } from 'astro:content';
import Page from 'virtual:wisp/components/Page';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('[wisp] 缺少 src/content/pages/about.md');
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<Page title={entry.data.title} description={entry.data.description} hasMath={Boolean(remarkPluginFrontmatter.hasMath)}>
  <Content />
</Page>
