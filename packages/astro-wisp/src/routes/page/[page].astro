---
import type { GetStaticPaths, Page } from 'astro';
import Base from 'virtual:wisp/components/Base';
import PostCard from 'virtual:wisp/components/PostCard';
import Pagination from 'virtual:wisp/components/Pagination';
import { getPosts, homePagedPosts, type PostEntry } from '../../utils/posts';
import { getReadingTimes } from '../../utils/reading';
import config from 'virtual:wisp/config';

export const getStaticPaths = (async ({ paginate }) => {
  // 有系列时首页是总目录、没有分页列表，homePagedPosts 返回空 → 不生成任何 /page/n/。
  // 没有系列时排除首页精选区的文章，避免第 2 页重复出现。
  // Astro 内置分页；第 1 页就是首页（/，带精选区），这里只生成第 2 页起。
  return paginate(homePagedPosts(await getPosts(), config.home.featuredCount), {
    pageSize: config.home.pageSize,
  }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<PostEntry>;
}
const { page } = Astro.props;
const posts = page.data;
const current = page.currentPage;
const times = await getReadingTimes(posts);
---

<Base title={`第 ${current} 页`}>
  <div class="wisp-container list-page">
    <h1 class="list-title">最新文章</h1>
    <ul class="list">
      {posts.map((post, i) => (
        <li>
          <PostCard post={post} readingTime={times[i]} headingLevel={2} showTags={false} />
        </li>
      ))}
    </ul>
    <Pagination current={current} total={page.lastPage} />
  </div>
</Base>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .list-page {
      padding-top: 3.5rem;
    }
    /* 与 Page 布局的页头同一规格 */
    .list-title {
      margin: 0 0 2.75rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--wisp-border);
      font-size: clamp(1.75rem, 1.2rem + 2vw, 2.375rem);
      font-weight: 700;
      line-height: 1.25;
    }
    .list {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .list > li {
      padding-block: 1.5rem;
      border-top: 1px solid var(--wisp-border);
    }
    .list > li:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
