---
import Page from 'virtual:wisp/components/Page';
import { getPosts, groupByYear, summarizeSeries } from '../utils/posts';
import { formatDate } from '../utils/date';
import { toISODate } from '../utils/date';
import config from 'virtual:wisp/config';
import { sitePath } from '../utils/paths';

const posts = await getPosts();
const groups = groupByYear(posts);
const seriesName = new Map(
  summarizeSeries(posts).map((s) => [s.id, s.title.split(/[：:]/)[0]!.trim()]),
);
// 系列篇的「05 标题」拆成编号列 + 标题（与首页目录、系列栏同一规则）；
// 只要有一篇带编号，所有行都留出编号列，标题左缘对齐
const split = (t: string) => {
  const m = /^(\d{1,3})[\s　]+(.+)$/.exec(t);
  return m ? { no: m[1]!, text: m[2]! } : { no: '', text: t };
};
const numbered = posts.some((p) => split(p.data.title).no);
const short = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
---

<Page title="归档" description={`共 ${posts.length} 篇文章`} prose={false}>
  {groups.map(({ year, posts }) => (
    <section class:list={['year', { numbered }]}>
      <h2>
        {year} <span class="count">{posts.length}</span>
      </h2>
      <ul>
        {posts.map((p) => {
          const { no, text } = split(p.data.title);
          return (
            <li>
              <time
                datetime={toISODate(p.data.pubDate)}
                title={formatDate(p.data.pubDate, p.data.lang ?? config.site.lang)}
              >
                {short(p.data.pubDate)}
              </time>
              <a href={sitePath(import.meta.env.BASE_URL, `/posts/${p.id}/`)} lang={p.data.lang}>
                {numbered ? (
                  <>
                    <span class="no">{no}</span> <span class="title">{text}</span>
                  </>
                ) : (
                  p.data.title
                )}
              </a>
              <span class="part">{p.data.series ? seriesName.get(p.data.series.id) : ''}</span>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Page>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    /* 每年一张三线表：日期 | 标题 | 所属系列 */
    .year + .year {
      margin-top: 3rem;
    }
    h2 {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin: 0 0 0.75rem;
      font-size: 1.25rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .count {
      color: var(--wisp-muted);
      font-size: 0.8125rem;
      font-weight: 400;
    }
    ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--wisp-fg);
      border-bottom: 1px solid var(--wisp-fg);
    }
    li {
      display: grid;
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: baseline;
      padding-block: 0.5rem;
    }
    li + li {
      border-top: 1px solid var(--wisp-border);
    }
    time,
    .part {
      color: var(--wisp-muted);
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
    }
    a {
      color: var(--wisp-fg);
      transition: color 150ms;
    }
    a:hover {
      color: var(--wisp-accent);
    }
    /* 编号列：表格数字、muted，标题悬挂对齐（与首页目录同宽同字号） */
    .numbered a {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      column-gap: 0.5rem;
      align-items: baseline;
    }
    .no {
      color: var(--wisp-muted);
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
      transition: color 150ms;
    }
    a:hover .no {
      color: var(--wisp-accent);
    }
    /* 触屏：标题链接的命中区铺满整行（≥44px），外观不变 */
    @media (pointer: coarse) {
      li {
        position: relative;
      }
      a::after {
        content: '';
        position: absolute;
        inset: 0;
      }
    }
    @media (max-width: 39.99rem) {
      li {
        grid-template-columns: 3.25rem minmax(0, 1fr);
      }
      .part {
        display: none;
      }
    }
  }
</style>
