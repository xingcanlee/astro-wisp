{
  "name": "astro-wisp",
  "version": "0.2.4",
  "type": "module",
  "description": "Wisp —— 安静好读的技术博客主题（Astro 集成）",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/astro-wisp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/astro-wisp.git",
    "directory": "packages/astro-wisp"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/astro-wisp/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-theme",
    "withastro",
    "blog",
    "tailwindcss",
    "mdx",
    "katex",
    "mermaid"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    ".": "./index.ts",
    "./content": "./src/content.ts",
    "./utils": "./src/utils/index.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./explainers": "./src/explainers/index.ts",
    "./explainers/core": "./src/explainers/core/index.ts",
    "./styles/*": "./src/styles/*",
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wisp": "bin/wisp.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "index.ts",
    "virtual.d.ts",
    "bin",
    "design",
    "scripts",
    "skills",
    "src",
    "!**/*.test.ts",
    "!**/__snapshots__",
    "!**/*.fixture.ts",
    "!skills/**/tests",
    "!skills/**/__pycache__",
    "!skills/**/.venv"
  ],
  "scripts": {
    "tokens": "tsx scripts/gen-tokens.ts",
    "contrast": "tsx scripts/check-contrast.ts"
  },
  "peerDependencies": {
    "astro": "^7.4.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify/utils": "^3.1.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "culori": "^4.0.2",
    "katex": "^0.19.1",
    "pele": "^1.13.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
