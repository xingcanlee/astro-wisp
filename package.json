{
  "name": "astro-wisp-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wisp 主题仓库：packages/astro-wisp（主题包）+ 根目录演示站 + template/（starter）",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/astro-wisp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/astro-wisp.git"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/astro-wisp/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "pnpm --filter astro-wisp tokens",
    "contrast": "pnpm --filter astro-wisp contrast",
    "diagram": "wisp diagram",
    "build:template": "pnpm --filter my-wisp-site build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "astro check && tsc --noEmit -p . && vitest run && pnpm contrast && wisp diagram check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.3",
    "astro": "^7.4.6",
    "astro-wisp": "workspace:*",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
