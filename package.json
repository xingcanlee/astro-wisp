{
  "name": "astro-wisp-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wisp 主题仓库：packages/astro-wisp（主题包）+ 根目录演示站 + template/（starter）",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/astro-wisp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/astro-wisp.git"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/astro-wisp/issues"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "pnpm --filter astro-wisp tokens",
    "contrast": "pnpm --filter astro-wisp contrast",
    "diagram": "wisp diagram",
    "build:template": "pnpm --filter my-wisp-site build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "astro check && tsc --noEmit -p . && eslint . && prettier . --check && vitest run && pnpm contrast && wisp diagram check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.3",
    "astro": "^7.4.6",
    "astro-wisp": "workspace:*",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mdx,yaml,yml}": "prettier --write"
  }
}
